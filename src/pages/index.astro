---
// =============================================================================
// src/pages/index.astro — Homepage
//
// index.html ka design, components mein toota hua. Design dobara nahi likha.
//
// ★ Har number ASLI hai. Jo counts index.html mein thay ("148 tutors",
//   "Peshawar mein live") wo design reference thay — yahan sab src/data se
//   aata hai. Firestore khali ho to empty state dikhta hai.
// =============================================================================
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SearchForm from '../components/SearchForm.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SubjectTiles from '../components/SubjectTiles.astro';
import TutorGrid from '../components/TutorGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrustSection from '../components/TrustSection.astro';
import RecruitCta from '../components/RecruitCta.astro';
import { cities, stats, tutors } from '../lib/data';
import { rank } from '../lib/seo';
import { isFeatured } from '../lib/types';

const hasTutors = tutors.length > 0;

// Sirf wo cities jahan waqai tutor mojood hai.
const liveCities = cities
  .filter((c) => tutors.some((t) => t.city === c.slug))
  .map((c) => c.name);

const liveLine =
  liveCities.length === 0 ? null
  : liveCities.length === 1 ? `Abhi ${liveCities[0]} mein live`
  : `Abhi ${liveCities.slice(0, -1).join(', ')} aur ${liveCities.at(-1)} mein live`;

// Featured pehle; koi featured na ho to sabse naye approved tutors.
const featured = tutors.filter(isFeatured);
const showcase = rank(featured.length > 0 ? featured : tutors).slice(0, 6);

const title = hasTutors
  ? `Verified Home & Online Tutors in Pakistan — ${stats.tutorCount} Tutors | ApnaTutor`
  : 'Verified Home & Online Tutors in Pakistan | ApnaTutor';

const description = hasTutors
  ? `Pakistan mein ${stats.tutorCount} verified home aur online tutors, ${stats.cityCount} cities mein. Class, subject aur budget ke hisaab se dhoondein. Parents ke liye free.`
  : 'Pakistan mein apne area ka verified home tutor ya online tutor dhoondein. Class, subject, area aur budget ke hisaab se filter karein. Parents ke liye bilkul free.';
---
<Base title={title} description={description} path="/" showStickyCta bodyClass="has-sticky-cta">
  <!-- HERO — search hi primary CTA hai -->
  <div class="hero">
    <div class="wrap">
      <div class="hero-head">
        {liveLine && (
          <span class="eyebrow"><Icon name="map-pin" size={16} />{liveLine}</span>
        )}
        <h1>Apne area ka <em>right tutor</em>, ek jagah.</h1>
        <p class="hero-sub">
          Class, subject, area aur budget batayein — ApnaTutor aapke liye matching tutors
          dhoondega. Home tuition ho ya online, verified profiles ke saath.
        </p>
      </div>
      <SearchForm />
    </div>
  </div>

  <TrustStrip />
  <SubjectTiles />

  <!-- TUTORS -->
  <section class="sec-alt">
    <div class="wrap">
      <div class="sec-bar">
        <div class="sec-head">
          <h2>{featured.length > 0 ? 'Featured tutors' : 'Naye tutors'}</h2>
          <p>
            {hasTutors
              ? 'Profile khol kar poori detail dekhein — qualification, fee range aur availability.'
              : 'Pehle tutors onboard ho rahe hain.'}
          </p>
        </div>
        {hasTutors && <a class="btn btn-outline btn-sm" href="/teachers">Saare tutors dekhein</a>}
      </div>

      <TutorGrid
        tutors={showcase}
        emptyTitle="Abhi koi tutor live nahi hai"
        emptyBody="Pehle tutors onboard ho rahe hain. Aap apni requirement post kar dein — jaise hi aapke area mein matching tutor aayega, hum aapko bata denge."
      />
    </div>
  </section>

  <HowItWorks />
  <TrustSection />
  <RecruitCta />

  <style>
    .hero{background:
        radial-gradient(900px 380px at 15% -10%,#E6FFFB 0%,transparent 60%),
        linear-gradient(180deg,var(--primary-soft) 0%,var(--bg) 100%);
      padding:var(--space-5) 0 var(--space-4);border-bottom:1px solid var(--border)}
    .hero-head{max-width:660px;margin-bottom:var(--space-3)}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;background:#fff;
      border:1px solid var(--primary-border);color:var(--primary-dark);
      padding:6px 14px;border-radius:var(--radius-pill);font-size:14px;font-weight:600;
      margin-bottom:var(--space-2)}
    .hero h1{font-size:clamp(30px,6vw,50px);font-weight:700;max-inline-size:22ch;text-wrap:balance}
    .hero h1 em{font-style:normal;color:var(--primary)}
    .hero-sub{margin-top:14px;font-size:clamp(16px,2.2vw,19px);color:var(--muted-fg);max-inline-size:52ch}
  </style>
</Base>
