---
// src/pages/admin/reviews.astro
//
// ★ Review approve karte waqt us tutor ki rating YAHIN recompute hoti hai —
//   Cloud Functions Spark par nahi hain, isliye ye kaam admin panel ka hai.
//   Recompute hamesha scratch se hota hai (docs/05-RISKS.md §7).
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
---
<App
  title="Admin — Reviews | ApnaTutor"
  heading="Reviews"
  sub="Approve karne par us tutor ki rating foran dobara calculate hoti hai."
  admin
  path="/admin/reviews"
>
  <div id="admin-reviews">
    <div class="tabs-row" role="tablist" aria-label="Review status">
      <button type="button" role="tab" class="filter" data-status="pending" aria-selected="true">Pending</button>
      <button type="button" role="tab" class="filter" data-status="approved" aria-selected="false" tabindex="-1">Approved</button>
      <button type="button" role="tab" class="filter" data-status="rejected" aria-selected="false" tabindex="-1">Rejected</button>
    </div>

    <p class="state state-info">
      <Icon name="info" />
      <span>
        Wo review reject karein jo jhoota lage, zaati hamla ho, ya jismein kisi ka phone number
        ya address ho. Reject karne par bhi rating dobara calculate hoti hai.
      </span>
    </p>

    <div class="skeleton sk-box" data-loading></div>
    <p class="state state-error" data-error hidden><Icon name="alert-circle" /><span></span></p>
    <div data-list hidden></div>
  </div>

  <style>
    #admin-reviews{display:flex;flex-direction:column;gap:var(--space-3)}
    .sk-box{height:220px}
    .tabs-row{display:flex;gap:6px;flex-wrap:wrap}
    .filter{min-height:44px;padding:10px 18px;border-radius:var(--radius-pill);
      border:1px solid var(--border-strong);background:#fff;cursor:pointer;
      font-family:var(--font-heading);font-size:14.5px;font-weight:600;color:var(--muted-fg)}
    .filter:hover{border-color:var(--primary-border)}
    .filter[aria-selected="true"]{background:var(--primary);border-color:var(--primary);color:#fff}
  </style>

  <script src="../../scripts/admin-reviews.ts"></script>
</App>
