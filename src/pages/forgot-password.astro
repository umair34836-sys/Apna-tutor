---
import Base from '../layouts/Base.astro';
import AuthCard from '../components/AuthCard.astro';
import Icon from '../components/Icon.astro';
---
<Base
  title="Reset Password | ApnaTutor"
  description="ApnaTutor ka password reset karein."
  path="/forgot-password"
  noindex
>
  <AuthCard
    heading="Password reset"
    sub="Apna email likhein — hum reset ka link bhej denge."
  >
    <form id="reset-form" novalidate>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
        <p class="err" id="e-email"><Icon name="alert-circle" size={15} strokeWidth={2.5} /> Email likhna zaroori hai</p>
      </div>

      <p class="state state-error" id="form-error" hidden><Icon name="alert-circle" /><span></span></p>

      <button type="submit" class="btn btn-primary btn-block" id="submit">Reset link bhejein</button>
    </form>

    <div id="done" hidden>
      <p class="state state-success">
        <Icon name="check-circle" />
        <span>
          Agar is email par account hai to reset link bhej diya gaya hai.
          Inbox (aur spam folder) check karein.
        </span>
      </p>
      <a class="btn btn-outline btn-block" href="/login" style="margin-top:var(--space-2)">Login par wapas</a>
    </div>

    <p class="alt"><a href="/login">Login par wapas</a></p>
  </AuthCard>

  <style>
    form{display:flex;flex-direction:column;gap:var(--space-2)}
    .alt{text-align:center;font-size:14.5px;color:var(--muted-fg);margin-top:var(--space-1)}
  </style>

  <script>
    import { sendPasswordReset, authError } from '../lib/auth';

    const form = document.getElementById('reset-form') as HTMLFormElement;
    const email = document.getElementById('email') as HTMLInputElement;
    const submit = document.getElementById('submit') as HTMLButtonElement;
    const errorBox = document.getElementById('form-error') as HTMLElement;
    const done = document.getElementById('done') as HTMLElement;

    email.addEventListener('input', () => {
      if (email.value) {
        email.closest('.field')?.classList.remove('invalid');
        document.getElementById('e-email')?.classList.remove('show');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;

      if (!email.value.trim()) {
        email.closest('.field')?.classList.add('invalid');
        document.getElementById('e-email')?.classList.add('show');
        email.setAttribute('aria-invalid', 'true');
        email.focus();
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Bhej rahe hain…';

      try {
        await sendPasswordReset(email.value.trim());
        // ★ Kamyabi ya "user not found" — dono par wahi message. Warna ye page
        //   batane lagta hai ke kaunse email par account hai.
        form.hidden = true;
        done.hidden = false;
      } catch (err) {
        const code = (err as { code?: string })?.code ?? '';
        if (code === 'auth/user-not-found' || code === 'auth/invalid-credential') {
          form.hidden = true;
          done.hidden = false;
          return;
        }
        errorBox.querySelector('span')!.textContent = authError(err);
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Reset link bhejein';
      }
    });
  </script>
</Base>
