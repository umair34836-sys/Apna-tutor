---
import { AREA_LABEL, ONLY_AREA, url } from '../../lib/site';
// src/pages/tutor/profile.astro — apni profile edit karein
//
// ★ Trust fields (status, badges, ratings, featured placement, approved photo)
//   yahan READ-ONLY hain, aur har ek ke saath wajah likhi hai. Rules bhi inhe
//   rokti hain — lekin UI mein disabled input dikhana behtar hai, warna user
//   bhar kar submit karta hai aur "permission denied" milta hai.
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
import { cities, subjects } from '../../lib/data';
import { BOARDS, CLASSES, MODES } from '../../lib/taxonomy';

const cityAreas = Object.fromEntries(cities.map((c) => [c.slug, c.areas]));
---
<App
  title="My Tutor Profile | ApnaTutor"
  heading="Meri profile"
  sub="Apni maloomat kabhi bhi update karein. Tabdeeli agli build par live hoti hai (zyada se zyada 6 ghante)."
  role="tutor"
  path="/tutor/profile"
>
  <div id="profile-page" data-city-areas={JSON.stringify(cityAreas)}>
    <div class="skeleton sk-box" data-loading></div>
    <p class="state state-error" data-error hidden><Icon name="alert-circle" /><span></span></p>

    <div data-no-profile hidden>
      <div class="empty">
        <Icon name="user-plus" />
        <h3>Abhi profile nahi bani</h3>
        <p>Profile banaye bagair aap search mein nazar nahi aayenge.</p>
        <a class="btn btn-primary" href={url('/tutor/register')}>Profile banayein</a>
      </div>
    </div>

    <form id="edit-form" novalidate hidden>
      <!-- Read-only: trust fields -->
      <section class="card locked">
        <div class="card-head">
          <h2><Icon name="lock" size={18} />ApnaTutor team set karti hai</h2>
        </div>
        <p class="card-sub">
          Ye cheezein aap nahi badal sakte — aur yahi is platform ka sabse ahem usool hai.
          Agar tutors khud apne badges ya rating laga sakte, to badges ka koi matlab hi na rehta.
        </p>

        <dl class="locked-grid">
          <div><dt>Status</dt><dd data-f-status>—</dd></div>
          <div><dt>Rating</dt><dd data-f-rating>—</dd></div>
          <div><dt>Verification badges</dt><dd data-f-badges>—</dd></div>
          <div><dt>Profile photo</dt><dd data-f-photo>—</dd></div>
          <div><dt>Profile URL</dt><dd data-f-slug>—</dd></div>
          <div><dt>Featured placement</dt><dd data-f-featured>—</dd></div>
        </dl>

        <p class="card-note">
          <Icon name="info" size={16} />
          Profile URL isliye fix hai ke badalne se Google aur share kiye hue links toot jate hain.
          Badalwana zaroori ho to <a href={url('/contact')}>hamein likhein</a>.
        </p>
      </section>

      <!-- Editable -->
      <section class="card">
        <h2>Buniyadi maloomat</h2>

        <div class="field">
          <label for="name">Poora naam</label>
          <input type="text" id="name" maxlength="60" required />
          <p class="err" id="e-name"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </div>

        <div class="field">
          <label for="city">{AREA_LABEL}</label>
          <select id="city" required>
            {cities.map((c) => <option value={c.slug} selected={Boolean(ONLY_AREA)}>{c.name}</option>)}
          </select>
          <p class="err" id="e-city"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </div>

        <fieldset class="pickers">
          <legend>Mohallay</legend>
          <div class="chips-input" id="areas-box"></div>
          <p class="hint">Zyada se zyada 6.</p>
          <p class="err" id="e-areas"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </fieldset>
      </section>

      <section class="card">
        <h2>Parhai</h2>

        <fieldset class="pickers">
          <legend>Subjects</legend>
          <div class="chips-input">
            {subjects.map((s) => (
              <label class="pick"><input type="checkbox" name="subjects" value={s.slug} /><span>{s.name}</span></label>
            ))}
          </div>
          <p class="err" id="e-subjects"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </fieldset>

        <fieldset class="pickers">
          <legend>Classes</legend>
          <div class="chips-input">
            {CLASSES.map((c) => (
              <label class="pick"><input type="checkbox" name="classes" value={c.slug} /><span>{c.labelUrdu}</span></label>
            ))}
          </div>
          <p class="err" id="e-classes"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </fieldset>

        <fieldset class="pickers">
          <legend>Boards</legend>
          <div class="chips-input">
            {BOARDS.map((b) => (
              <label class="pick"><input type="checkbox" name="boards" value={b.slug} /><span>{b.labelUrdu}</span></label>
            ))}
          </div>
          <p class="err" id="e-boards"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </fieldset>

        <fieldset class="pickers">
          <legend>Teaching mode</legend>
          <div class="chips-input">
            {MODES.map((m) => (
              <label class="pick"><input type="checkbox" name="modes" value={m.slug} /><span>{m.labelUrdu}</span></label>
            ))}
          </div>
          <p class="err" id="e-modes"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </fieldset>
      </section>

      <section class="card">
        <h2>Tajurba aur fee</h2>

        <div class="field">
          <label for="qualification">Qualification</label>
          <input type="text" id="qualification" maxlength="100" required />
          <p class="err" id="e-qualification"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </div>

        <div class="field">
          <label for="experienceYears">Tajurba (saal)</label>
          <input type="number" id="experienceYears" min="0" max="50" step="1" required />
          <p class="err" id="e-experienceYears"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </div>

        <div class="field-grid">
          <div class="field">
            <label for="feeMin">Kam az kam fee (Rs.)</label>
            <input type="number" id="feeMin" min="500" max="200000" step="100" required />
            <p class="err" id="e-feeMin"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
          </div>
          <div class="field">
            <label for="feeMax">Zyada se zyada fee (Rs.)</label>
            <input type="number" id="feeMax" min="500" max="200000" step="100" required />
            <p class="err" id="e-feeMax"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
          </div>
        </div>

        <div class="field">
          <label for="availability">Availability</label>
          <input type="text" id="availability" maxlength="120" required />
          <p class="err" id="e-availability"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </div>

        <div class="field">
          <label for="bio">Apne baare mein</label>
          <textarea id="bio" maxlength="600" rows="6"></textarea>
          <p class="hint"><span id="bio-count">0</span> / 600</p>
          <p class="err" id="e-bio"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </div>
      </section>

      <section class="card">
        <h2>Rabta <span class="tag">Private</span></h2>
        <p class="card-sub">
          Ye number kisi public page par nahi jata. Sirf wo parents dekhte hain jo login karke
          aap ka contact kholte hain.
        </p>

        <div class="field">
          <label for="phone">Phone number</label>
          <div class="phone-input">
            <span class="prefix" aria-hidden="true">+92</span>
            <input type="tel" id="phone" inputmode="numeric" maxlength="11" placeholder="3001234567" required />
          </div>
          <p class="err" id="e-phone"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </div>

        <div class="field">
          <label for="whatsapp">WhatsApp number</label>
          <div class="phone-input">
            <span class="prefix" aria-hidden="true">+92</span>
            <input type="tel" id="whatsapp" inputmode="numeric" maxlength="11" placeholder="3001234567" required />
          </div>
          <p class="err" id="e-whatsapp"><Icon name="alert-circle" size={15} strokeWidth={2.5} /><span></span></p>
        </div>
      </section>

      <div class="save-bar">
        <p class="state state-success" data-saved hidden><Icon name="check-circle" />Save ho gaya</p>
        <p class="state state-error" data-save-error hidden><Icon name="alert-circle" /><span></span></p>
        <button type="submit" class="btn btn-primary" id="save"><Icon name="check" />Tabdeeli save karein</button>
      </div>
    </form>
  </div>

  <style>
    #profile-page{display:flex;flex-direction:column;gap:var(--space-3)}
    .sk-box{height:260px}
    form{display:flex;flex-direction:column;gap:var(--space-3)}
    .card{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
      padding:var(--space-3);display:flex;flex-direction:column;gap:var(--space-2)}
    .card h2{font-size:18px;font-weight:600;display:flex;align-items:center;gap:8px}
    .card-sub{color:var(--muted-fg);font-size:15px;max-width:66ch}
    .card-head{display:flex;justify-content:space-between;align-items:center;gap:var(--space-2);flex-wrap:wrap}
    .card-note{display:flex;gap:8px;align-items:flex-start;font-size:14px;color:var(--muted-fg);
      border-top:1px solid var(--border);padding-top:var(--space-2)}
    .card-note :global(.icon){color:var(--icon-muted);flex:0 0 auto;margin-top:2px}
    .tag{font-family:var(--font-body);font-size:12px;font-weight:600;text-transform:uppercase;
      letter-spacing:.05em;background:var(--b-id-bg);color:var(--b-id-fg);
      border:1px solid var(--b-id-border);border-radius:var(--radius-pill);padding:3px 9px}

    .locked{background:var(--bg-alt)}
    .locked-grid{display:grid;grid-template-columns:1fr;gap:8px;margin:0}
    @media(min-width:620px){.locked-grid{grid-template-columns:1fr 1fr}}
    .locked-grid > div{padding:12px 14px;background:#fff;border:1px solid var(--border);
      border-radius:var(--radius)}
    .locked-grid dt{font-size:12.5px;color:var(--muted-fg);text-transform:uppercase;
      letter-spacing:.04em;font-weight:600}
    .locked-grid dd{margin:3px 0 0;font-size:15.5px;color:var(--fg)}

    .pickers{border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
    .pickers > legend{font-family:var(--font-heading);font-size:14px;font-weight:600;color:var(--fg);padding:0}
    .chips-input{display:flex;flex-wrap:wrap;gap:8px}
    .pick{cursor:pointer}
    .pick input{position:absolute;opacity:0;width:0;height:0}
    .pick span{display:inline-flex;align-items:center;min-height:44px;padding:10px 16px;
      border:1px solid var(--border-strong);border-radius:var(--radius-pill);background:#fff;
      font-size:14.5px;transition:border-color .2s var(--ease),background-color .2s var(--ease)}
    .pick:hover span{border-color:var(--primary-border)}
    .pick input:checked + span{background:var(--primary);border-color:var(--primary);color:#fff;font-weight:600}
    .pick input:focus-visible + span{outline:3px solid var(--primary-bright);outline-offset:2px}
    .pick input:disabled + span{opacity:.45;cursor:not-allowed}

    .phone-input{display:flex;align-items:stretch}
    .phone-input .prefix{display:grid;place-items:center;padding:0 14px;min-height:48px;
      background:var(--bg-alt);border:1px solid var(--border-strong);border-right:0;
      border-radius:var(--radius) 0 0 var(--radius);font-size:16px;color:var(--muted-fg);font-weight:600}
    .phone-input input{border-radius:0 var(--radius) var(--radius) 0}

    .save-bar{position:sticky;bottom:0;background:var(--bg);border-top:1px solid var(--border);
      padding:var(--space-2) 0;display:flex;gap:var(--space-2);align-items:center;flex-wrap:wrap}
    .save-bar .btn{margin-left:auto}
  </style>

  <script src="../../scripts/tutor-profile.ts"></script>
</App>
