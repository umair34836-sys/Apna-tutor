---
import { url } from '../../lib/site';
// src/pages/tutor/leads.astro — tutor ka leads inbox
//
// ★ Lead card par parent ka number KABHI nahi hota — rules `parentPhone` wala
//   lead banne hi nahi deti. Tutor "Interested" karta hai, phir parent faisla
//   karta hai ke number dena hai ya nahi.
import App from '../../layouts/App.astro';
import Icon from '../../components/Icon.astro';
---
<App
  title="Tuition Leads | ApnaTutor"
  heading="Leads"
  sub="Aap ke area aur subjects ki tuition requests."
  role="tutor"
  path="/tutor/leads"
>
  <div id="leads">
    <div class="tabs-row" data-filters hidden role="tablist" aria-label="Leads filter">
      <button type="button" role="tab" class="filter" data-filter="new" aria-selected="true">Nayi</button>
      <button type="button" role="tab" class="filter" data-filter="interested" aria-selected="false" tabindex="-1">Interested</button>
      <button type="button" role="tab" class="filter" data-filter="declined" aria-selected="false" tabindex="-1">Declined</button>
    </div>

    <p class="state state-info privacy-note" data-filters-note hidden>
      <Icon name="lock" />
      <span>Parent ka number in cards par nahi hota. "Interested" karne par parent ko pata chal jata hai, phir wo khud rabta karte hain.</span>
    </p>

    <div class="skeleton sk-box" data-loading></div>
    <p class="state state-error" data-error hidden><Icon name="alert-circle" /><span></span></p>

    <div data-not-approved hidden>
      <div class="empty">
        <Icon name="clock" />
        <h3>Leads approve hone ke baad aati hain</h3>
        <p>Aap ki profile abhi review mein hai. Approve hote hi aap ke area ki requests yahan aane lagengi.</p>
        <a class="btn btn-primary" href={url('/tutor/dashboard')}>Dashboard</a>
      </div>
    </div>

    <div data-list hidden></div>
  </div>

  <style>
    #leads{display:flex;flex-direction:column;gap:var(--space-3)}
    .sk-box{height:220px}
    .tabs-row{display:flex;gap:6px;flex-wrap:wrap}
    .filter{min-height:44px;padding:10px 18px;border-radius:var(--radius-pill);
      border:1px solid var(--border-strong);background:#fff;cursor:pointer;
      font-family:var(--font-heading);font-size:14.5px;font-weight:600;color:var(--muted-fg);
      transition:background-color .2s var(--ease),border-color .2s var(--ease),color .2s var(--ease)}
    .filter:hover{border-color:var(--primary-border)}
    .filter[aria-selected="true"]{background:var(--primary);border-color:var(--primary);color:#fff}
    .privacy-note{font-size:14.5px}

    .lead-grid{display:grid;grid-template-columns:1fr;gap:var(--space-2)}
    @media(min-width:760px){.lead-grid{grid-template-columns:repeat(2,1fr)}}
  </style>

  <script src="../../scripts/tutor-leads.ts"></script>
</App>
