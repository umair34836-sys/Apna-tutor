---
// =============================================================================
// src/layouts/App.astro — login-required pages ka shell
//
// Ye pages CSR hain: static HTML sirf khaka hai, data browser mein aata hai.
// Isliye teen baatein har aisi page par lazmi hain:
//   1. noindex — dashboard aur admin Google mein nahi hone chahiye
//   2. Auth gate — logged out ko /login par bhejo, screen khali na chhoro
//   3. Loading state — warna logged-in user ko ek pal "login karein" dikhta
//      hai, jo bura lagta hai
//
// ★ UI mein links chhupana security NAHI hai. Asli protection firestore.rules
//   hai. Ye gate sirf tajurbe ke liye hai.
// =============================================================================
import Base from './Base.astro';
import { url } from '../lib/site';
import Icon from '../components/Icon.astro';
import type { Role } from '../lib/auth';

export interface Props {
  title: string;
  description?: string;
  path?: string;
  /** Is role ke bagair user ko uske apne dashboard par bhej diya jata hai. */
  role?: Role;
  heading: string;
  sub?: string;
  /** Dashboard nav dikhana hai? Login/signup jaisi pages par nahi. */
  nav?: boolean;
  /** Admin pages — role ke bajaye `admins/{uid}` doc se gate hoti hain. */
  admin?: boolean;
}

const {
  title,
  description = 'ApnaTutor account.',
  path = Astro.url.pathname,
  role,
  heading,
  sub,
  nav = true,
  admin = false,
} = Astro.props;

const tutorNav = [
  { href: '/tutor/dashboard', label: 'Dashboard', icon: 'trending-up' },
  { href: '/tutor/leads', label: 'Leads', icon: 'inbox' },
  { href: '/tutor/profile', label: 'Meri profile', icon: 'user' },
];
const parentNav = [
  { href: '/parent/dashboard', label: 'Dashboard', icon: 'trending-up' },
  { href: '/parent/requests', label: 'Meri requests', icon: 'file-text' },
  { href: '/parent/saved-tutors', label: 'Saved tutors', icon: 'bookmark' },
];
const adminNav = [
  { href: '/admin', label: 'Overview', icon: 'trending-up' },
  { href: '/admin/tutors', label: 'Tutors', icon: 'users' },
  { href: '/admin/reviews', label: 'Reviews', icon: 'star-outline' },
  { href: '/admin/reports', label: 'Reports', icon: 'flag' },
  { href: '/admin/featured', label: 'Featured', icon: 'award' },
  { href: '/admin/content', label: 'Content', icon: 'file-text' },
  { href: '/admin/rebuild', label: 'Rebuild', icon: 'refresh' },
];

// `student` bhi parent wala area istemal karta hai — dono tutor dhoondte hain.
const links = admin ? adminNav : role === 'tutor' ? tutorNav : role ? parentNav : [];
const current = path;
---
<Base title={title} description={description} path={path} noindex>
  <div class="app" data-app data-role={role ?? ''} data-admin={admin ? '1' : ''}>
    <!-- Loading — auth state restore hone tak -->
    <div class="wrap app-loading" data-app-loading>
      <div class="skeleton sk-title"></div>
      <div class="skeleton sk-line"></div>
      <div class="skeleton sk-box"></div>
      <span class="sr-only">Load ho raha hai…</span>
    </div>

    <!-- Admin gate na khule to — wajah, aur usay theek karne ka tareeqa -->
    <div class="wrap gate-block" data-app-blocked hidden>
      <div class="gate-card">
        <Icon name="lock" />
        <h1 data-gate-title>Ye page nahi khul saka</h1>
        <p data-gate-detail></p>

        <div class="gate-uid">
          <span>Aapka UID</span>
          <code data-gate-uid></code>
          <button type="button" class="btn btn-outline btn-sm" data-gate-copy>Copy</button>
        </div>

        <div data-gate-fix></div>

        <p class="gate-actions">
          <a class="btn btn-primary btn-sm" href={url('/')}>Home</a>
          <button type="button" class="btn btn-ghost btn-sm" data-signout>Logout</button>
        </p>
      </div>
    </div>

    <!-- Content — gate pass hone par -->
    <div data-app-content hidden>
      {/* Logout yahan se hata diya. Har page ke sab se upar, heading ke
          barabar mein khara hona us button ka kaam nahi tha — ab wo header
          ke teen-lakeeron wale menu mein hai: milta asani se hai, magar
          saamne nahi rehta. */}
      <div class="wrap app-head">
        <div>
          <h1>{heading}</h1>
          {sub && <p class="app-sub">{sub}</p>}
        </div>
      </div>

      {nav && links.length > 0 && (
        <div class="wrap">
          <nav class="app-nav" aria-label="Account">
            {links.map((l) => (
              <a
                href={url(l.href)}
                aria-current={(l.href === '/admin' ? current === '/admin' : current.startsWith(l.href)) ? 'page' : undefined}
              >
                <Icon name={l.icon} size={17} />{l.label}
              </a>
            ))}
          </nav>
        </div>
      )}

      <div class="wrap app-body"><slot /></div>
    </div>
  </div>

  <style>
    .app{padding:var(--space-4) 0 var(--space-6)}
    .app-loading{display:flex;flex-direction:column;gap:var(--space-2)}
    .sk-title{height:36px;width:min(320px,70%)}
    .sk-line{height:18px;width:min(460px,90%)}
    .sk-box{height:220px;width:100%;margin-top:var(--space-2)}

    .app-head{display:flex;justify-content:space-between;align-items:flex-start;
      gap:var(--space-2);flex-wrap:wrap}
    .app-head h1{font-size:clamp(24px,4vw,32px);font-weight:700}
    .app-sub{margin-top:8px;color:var(--muted-fg);font-size:16px;max-width:60ch}

    .app-nav{display:flex;gap:4px;flex-wrap:wrap;margin-top:var(--space-3);
      border-bottom:1px solid var(--border);padding-bottom:2px}
    .app-nav a{display:inline-flex;align-items:center;gap:7px;padding:11px 14px;
      min-height:44px;color:var(--muted-fg);font-weight:500;font-size:15px;
      border-bottom:3px solid transparent;border-radius:var(--radius) var(--radius) 0 0}
    .app-nav a:hover{background:var(--bg-alt);color:var(--fg);text-decoration:none}
    .app-nav a[aria-current="page"]{color:var(--primary-dark);border-bottom-color:var(--primary);
      background:var(--primary-soft)}

    .app-body{margin-top:var(--space-4)}

    /* Gate block — pehla admin banate waqt yahi screen raasta dikhati hai */
    .gate-block{padding-block:var(--space-4)}
    .gate-card{max-width:640px;margin:0 auto;background:var(--card);border:1px solid var(--border);
      border-radius:var(--radius-lg);padding:var(--space-3)}
    .gate-card :global(.icon){width:28px;height:28px;color:var(--icon-muted)}
    .gate-card h1{font-size:clamp(21px,4vw,26px);margin-top:10px}
    /* Detail line mein `admins/<uid>` jaisa lamba token hota hai — bina is ke
       chhoti screen par poora page side mein khisak jata hai. */
    .gate-card p{margin-top:10px;color:var(--muted-fg);overflow-wrap:anywhere}
    .gate-uid{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:var(--space-2);
      padding:12px;background:var(--bg-alt);border:1px solid var(--border);border-radius:var(--radius)}
    .gate-uid span{font-size:13.5px;color:var(--muted-fg)}
    .gate-uid code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13.5px;
      word-break:break-all;flex:1;min-width:0}
    .gate-card :global(ol){margin-top:var(--space-2);padding-left:20px;display:grid;gap:8px;color:var(--muted-fg)}
    .gate-card :global(ol code){font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
      background:var(--bg-alt);padding:1px 5px;border-radius:4px;word-break:break-all}
    .gate-actions{display:flex;gap:var(--space-1);margin-top:var(--space-3)}
  </style>

  <script>
    import { url } from '../lib/site';
    import { adminBlock, getAdminSession, getSession, signOut } from '../lib/auth';
    import type { Role } from '../lib/auth';

    const root = document.querySelector<HTMLElement>('[data-app]');

    if (root) {
      const loading = root.querySelector<HTMLElement>('[data-app-loading]')!;
      const content = root.querySelector<HTMLElement>('[data-app-content]')!;
      const role = (root.dataset.role || undefined) as Role | undefined;
      const isAdminPage = root.dataset.admin === '1';

      // Admin pages `admins/{uid}` doc se gate hoti hain, role se nahi.
      const gate = isAdminPage ? getAdminSession() : getSession(role);

      gate.then((session) => {
        if (!session) {
          // Admin gate ruka ho to wajah dikhao. Baqi surton mein redirect ho
          // chuka hai — screen loading par hi rehne do, warna ek pal ke liye
          // ghalat content flash karta hai.
          const block = isAdminPage ? adminBlock() : null;
          if (block) showBlocked(block);
          return;
        }

        loading.hidden = true;
        content.hidden = false;

        // Page ka apna code getSession() se wahi session le leta hai —
        // memoized hai, isliye na extra read hoti hai na event ki race.
      });

      function showBlocked(block: { reason: string; uid: string; detail: string }) {
        const panel = root!.querySelector<HTMLElement>('[data-app-blocked]')!;
        const set = (sel: string, text: string) => {
          panel.querySelector<HTMLElement>(sel)!.textContent = text;
        };

        set('[data-gate-title]', block.reason === 'no-doc' ? 'Aap abhi admin nahi hain' : 'Admin check nahi ho saka');
        set('[data-gate-detail]', block.detail);
        set('[data-gate-uid]', block.uid);

        const fix = panel.querySelector<HTMLElement>('[data-gate-fix]')!;
        fix.innerHTML =
          block.reason === 'no-doc'
            ? `<ol>
                 <li>Firebase Console → Firestore Database kholein.</li>
                 <li><code>admins</code> collection mein naya document banayein.</li>
                 <li><strong>Document ID</strong> wahi UID ho jo upar likha hai —
                     UID ko field mein daalne se kaam nahi chalta, ID hi dekhi jati hai.</li>
                 <li>Fields khali chhor dein. Document ka mojood hona hi kaafi hai.</li>
                 <li>Page refresh karein.</li>
               </ol>`
            : `<ol>
                 <li>Firestore rules deploy karein:
                     <code>firebase deploy --only firestore:rules</code></li>
                 <li>Phir <code>admins</code> mein us UID ka document banayein
                     (Document ID = UID).</li>
                 <li>Page refresh karein.</li>
               </ol>`;

        panel.querySelector('[data-gate-copy]')?.addEventListener('click', async (e) => {
          const btn = e.currentTarget as HTMLButtonElement;
          try {
            await navigator.clipboard.writeText(block.uid);
            btn.textContent = 'Copy ho gaya';
          } catch {
            // Clipboard permission na ho to UID select kar dena hi kaafi hai.
            const code = panel.querySelector('[data-gate-uid]')!;
            const range = document.createRange();
            range.selectNodeContents(code);
            const sel = window.getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
            btn.textContent = 'Select ho gaya — copy karein';
          }
        });

        loading.hidden = true;
        panel.hidden = false;
      }

      root.querySelectorAll('[data-signout]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          await signOut();
          window.location.href = url('/');
        })
      );
    }
  </script>
</Base>
