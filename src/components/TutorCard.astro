---
// src/components/TutorCard.astro
//
// Markup src/lib/tutor-card.ts se aata hai, taake search results aur parent
// pages (jo JavaScript se render hote hain) bilkul wahi card dikhayein.
//
// `data-tutor-card` attribute scripts/validate-seo.mjs ginta hai — SEO combo
// page par 3 se kam hon to build toot jati hai. Isay hatana mat.
import { tutorCardHtml } from '../lib/tutor-card';
import type { Tutor } from '../lib/types';

export interface Props { tutor: Tutor; }
const { tutor } = Astro.props;
---
<Fragment set:html={tutorCardHtml(tutor)} />
