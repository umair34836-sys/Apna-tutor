---
import { url } from '../lib/site';
// src/components/Footer.astro
//
// Footer ke SEO links sirf un pages par jate hain jo waqai bani hain. Phase 1
// mein koi combo page nahi bana, isliye ye list build-time data se aati hai —
// hard-coded links 404 dete aur SEO ko nuqsan dete.
import Logo from './Logo.astro';
import { cities, subjects, tutors } from '../lib/data';
import { AREA_WORD, SERVICE_AREA_LABEL } from '../lib/site';

const MIN_TUTORS = 3; // thin-page gate (docs/02-PAGES-SPEC.md)

const cityLinks = cities
  .map((c) => ({
    href: `/home-tutor-${c.slug}`,
    label: `Home tutors in ${c.name}`,
    count: tutors.filter((t) => t.city === c.slug).length,
  }))
  .filter((l) => l.count >= MIN_TUTORS)
  .slice(0, 4);

const subjectLinks = cities
  .flatMap((c) =>
    subjects.map((s) => ({
      href: `/${s.slug}-tutor-${c.slug}`,
      label: `${s.name} tutors in ${c.name}`,
      count: tutors.filter((t) => t.city === c.slug && t.subjects.includes(s.slug)).length,
    }))
  )
  .filter((l) => l.count >= MIN_TUTORS)
  .sort((a, b) => b.count - a.count)
  .slice(0, 4);

const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-about">
        <Logo href={null} dark size={38} />
        <p>Apne {AREA_WORD} ka right tutor, ek jagah. Teacher aapke ghar aaye, bacha teacher ke ghar jaye, ya online — filhaal sirf {SERVICE_AREA_LABEL} mein.</p>
      </div>

      {cityLinks.length > 0 && (
        <div>
          <h4>Areas</h4>
          <ul>{cityLinks.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}</ul>
        </div>
      )}

      {subjectLinks.length > 0 && (
        <div>
          <h4>Popular searches</h4>
          <ul>{subjectLinks.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}</ul>
        </div>
      )}

      <div>
        <h4>ApnaTutor</h4>
        <ul>
          <li><a href={url('/how-it-works')}>Kaise kaam karta hai</a></li>
          <li><a href={url('/for-tutors')}>Tutors ke liye</a></li>
          <li><a href={url('/safety')}>Safety policy</a></li>
          <li><a href={url('/faq')}>FAQ</a></li>
          <li><a href={url('/contact')}>Rabta karein</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>&copy; {year} ApnaTutor. {SERVICE_AREA_LABEL}.</span>
      <span><a href={url('/privacy')}>Privacy</a> &nbsp;·&nbsp; <a href={url('/terms')}>Terms</a></span>
    </div>
  </div>
</footer>

<style>
  footer{background:var(--footer-bg);color:var(--footer-fg);padding:var(--space-5) 0 var(--space-3);font-size:15px}
  .foot-grid{display:grid;grid-template-columns:1fr;gap:var(--space-4)}
  @media(min-width:700px){.foot-grid{grid-template-columns:1.4fr 1fr 1fr 1fr}}
  footer h4{font-size:14px;color:#fff;text-transform:uppercase;letter-spacing:.06em;
    margin-bottom:14px;font-weight:600}
  footer ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
  footer a{color:var(--footer-fg)}
  footer a:hover{color:var(--footer-link-hover)}
  .foot-about :global(.logo){margin-bottom:14px}
  .foot-about p{font-size:14.5px;max-width:36ch;line-height:1.6}
  .foot-bottom{margin-top:var(--space-4);padding-top:var(--space-3);
    border-top:1px solid var(--footer-border);display:flex;flex-wrap:wrap;gap:var(--space-2);
    justify-content:space-between;font-size:14px}
</style>
