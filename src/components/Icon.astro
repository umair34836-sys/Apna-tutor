---
// =============================================================================
// src/components/Icon.astro — inline SVG icon
//
// Paths src/lib/icons.ts mein hain, taake JavaScript se render hone wale cards
// (search results, leads, admin queues) wahi icons istemal kar sakein.
// =============================================================================
import { ICON_PATHS } from '../lib/icons';

export interface Props {
  name: keyof typeof ICON_PATHS | string;
  size?: number;
  class?: string;
  /** Sirf tab do jab icon apne aap mein maani rakhta ho; warna aria-hidden rehta hai. */
  label?: string;
  strokeWidth?: number;
}

const { name, size, class: className = 'icon', label, strokeWidth } = Astro.props;
const icon = ICON_PATHS[name];
if (!icon) throw new Error(`Icon "${name}" src/lib/icons.ts mein mojood nahi hai.`);

const style = size ? `width:${size}px;height:${size}px` : undefined;
const a11y = label
  ? ({ role: 'img' as const, 'aria-label': label })
  : ({ 'aria-hidden': 'true' as const });
---
<svg
  class={className}
  style={style}
  viewBox="0 0 24 24"
  fill={icon.fill ?? 'none'}
  stroke={icon.fill === 'currentColor' ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {icon.extra && <Fragment set:html={icon.extra} />}
  {icon.d && <path d={icon.d} />}
</svg>
