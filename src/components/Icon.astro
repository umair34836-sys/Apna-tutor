export interface Props {
  name: keyof typeof PATHS | string;
  size?: number;
  class?: string;
  /** Sirf tab do jab icon apne aap mein maani rakhta ho; warna aria-hidden rehta hai. */
  label?: string;
  strokeWidth?: number;
}

const { name, size, class: className = 'icon', label, strokeWidth } = Astro.props;
const icon = PATHS[name];
if (!icon) throw new Error(`Icon "${name}" src/components/Icon.astro mein mojood nahi hai.`);

const style = size ? `width:${size}px;height:${size}px` : undefined;
const a11y = label
  ? ({ role: 'img' as const, 'aria-label': label })
  : ({ 'aria-hidden': 'true' as const });
---
<svg
  class={className}
  style={style}
  viewBox="0 0 24 24"
  fill={icon.fill ?? 'none'}
  stroke={icon.fill === 'currentColor' ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {icon.extra && <Fragment set:html={icon.extra} />}
  {icon.d && <path d={icon.d} />}
</svg>
