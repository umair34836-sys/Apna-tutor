---
import { url } from '../lib/site';
// src/components/AuthCard.astro — login/signup/reset ka centered card
import Logo from './Logo.astro';

export interface Props { heading: string; sub?: string; }
const { heading, sub } = Astro.props;
---
<div class="auth">
  <div class="auth-card">
    <Logo href={url('/')} size={34} class="auth-logo" />
    <h1>{heading}</h1>
    {sub && <p class="auth-sub">{sub}</p>}
    <slot />
  </div>
  <p class="auth-foot">
    <a href={url('/')}>Homepage</a> · <a href={url('/privacy')}>Privacy</a> · <a href={url('/terms')}>Terms</a>
  </p>
</div>

<style>
  .auth{max-width:460px;margin:0 auto;padding:var(--space-5) var(--space-2) var(--space-6)}
  .auth-card{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
    padding:var(--space-4) var(--space-3);box-shadow:var(--shadow-md);
    display:flex;flex-direction:column;gap:var(--space-2)}
  .auth-logo{margin-bottom:var(--space-1)}
  .auth-card h1{font-size:24px;font-weight:700}
  .auth-sub{color:var(--muted-fg);font-size:15.5px}
  .auth-foot{text-align:center;margin-top:var(--space-3);font-size:14px;color:var(--muted-fg)}

  /* ★ Auth card ke saare chhote link — "Password bhool gaye", "Naya account",
     Terms, Privacy. Ye 16px unche thay. Phone par yahi wo lamha hai jahan
     banda pehle se uljha hua hota hai; wahan chook jana sab se bura hai.
     `:global` is liye ke ye link card ke andar slot se aate hain. */
  .auth :global(.forgot a),
  .auth :global(.alt a),
  .auth-foot a{display:inline-flex;align-items:center;min-height:44px;padding-inline:4px}

  .auth :global(.logo){min-height:44px;display:inline-flex;align-items:center}
</style>
