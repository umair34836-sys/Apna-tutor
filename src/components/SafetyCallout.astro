---
// src/components/SafetyCallout.astro
//
// Har tutor profile aur trust section par. Ye legal aur safety dono ke liye
// zaroori hai — docs/05-RISKS.md §8.
import Icon from './Icon.astro';
---
<div class="callout">
  <Icon name="info" strokeWidth={2.2} />
  <p>
    <b>Zaroori baat:</b> ApnaTutor tutors ko connect karta hai, employ nahi karta.
    Verification badges documents aur phone checks par based hain — ye teaching quality
    ki guarantee nahi. Pehli class se pehle demo lein, aur chhote bachon ki tuition ke
    waqt ghar par kisi baray ki mojoodgi behtar hai.
  </p>
</div>
