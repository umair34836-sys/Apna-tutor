---
import { url } from '../lib/site';
// =============================================================================
// src/components/Header.astro
//
// Menu ke teen hissay hain, aur ye taqseem jaan boojh kar hai:
//
//   1. IS SECTION KA        — page ke hisaab se badalta hai. Admin panel mein
//                             admin ke pages, tutor ke area mein tutor ke.
//                             Ye build ke waqt tay hota hai (path se), is liye
//                             JS ke bagair bhi theek hai.
//   2. AAPKE ROLE KA        — tutor ko tutor ka dashboard, parent/student ko
//                             apna. Ye browser mein tay hota hai (auth hint),
//                             kyunki static page ko pata nahi hota kaun aaya.
//   3. HAR JAGAH WALE       — chaar buniyadi links jo har haal mein chahiye.
//
// ★ Pehle teeno hissay ek hi thay: har page par, har role ko, bilkul wahi
//   saat links. Admin panel mein khare ho kar admin ke baqi pages tak
//   pohanchne ka koi raasta hi nahi tha.
//
// ★ Auth state yahan localStorage ke hint se aati hai, Firebase se nahi.
//   Header har page par hai — static pages par bhi — aur wahan 300 KB ka SDK
//   load karna poori architecture ke khilaf hai. Tafseel src/lib/auth-hint.ts.
// =============================================================================
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Link { href: string; label: string; icon: string }

/** Har jagah — chahe kaun bhi ho, kahin bhi ho. */
const universal: Link[] = [
  { href: '/find-tutor',    label: 'Tutor dhoondein',      icon: 'search' },
  { href: '/request-tutor', label: 'Request post karein',  icon: 'send' },
  { href: '/how-it-works',  label: 'Kaise kaam karta hai', icon: 'help' },
  { href: '/teachers',      label: 'Saare tutors',         icon: 'users' },
];

interface Section { title: string; match: (p: string) => boolean; links: Link[] }

/**
 * Section kaun sa hai — page ke raaste se. Pehla match jeet jata hai, is liye
 * khaas raaste (admin, tutor, parent) aam raaston se pehle likhe hain.
 */
const sections: Section[] = [
  {
    title: 'Admin',
    match: (p) => p === '/admin' || p.startsWith('/admin/'),
    links: [
      { href: '/admin',          label: 'Overview', icon: 'trending-up' },
      { href: '/admin/tutors',   label: 'Tutors',   icon: 'users' },
      { href: '/admin/reviews',  label: 'Reviews',  icon: 'star-outline' },
      { href: '/admin/reports',  label: 'Reports',  icon: 'flag' },
      { href: '/admin/featured', label: 'Featured', icon: 'award' },
      { href: '/admin/content',  label: 'Content',  icon: 'file-text' },
      { href: '/admin/rebuild',  label: 'Rebuild',  icon: 'refresh' },
    ],
  },
  {
    title: 'Mera tutor account',
    match: (p) => p.startsWith('/tutor/') && p !== '/tutor/register',
    links: [
      { href: '/tutor/dashboard', label: 'Dashboard',    icon: 'trending-up' },
      { href: '/tutor/leads',     label: 'Leads',        icon: 'inbox' },
      { href: '/tutor/profile',   label: 'Meri profile', icon: 'user' },
    ],
  },
  {
    title: 'Mera account',
    match: (p) => p.startsWith('/parent/'),
    links: [
      { href: '/parent/dashboard',    label: 'Dashboard',     icon: 'trending-up' },
      { href: '/parent/requests',     label: 'Meri requests', icon: 'file-text' },
      { href: '/parent/saved-tutors', label: 'Saved tutors',  icon: 'bookmark' },
    ],
  },
  {
    title: 'Tutors ke liye',
    match: (p) => p === '/for-tutors' || p === '/tutor/register',
    links: [
      { href: '/for-tutors',     label: 'Tutors ke liye',    icon: 'graduation-cap' },
      { href: '/tutor/register', label: 'Tutor banein',      icon: 'user-plus' },
      { href: '/how-it-works',   label: 'Kaise kaam karta hai', icon: 'help' },
    ],
  },
  {
    title: 'Account',
    match: (p) => ['/login', '/signup', '/forgot-password'].includes(p),
    links: [
      { href: '/login',           label: 'Login',              icon: 'user' },
      { href: '/signup',          label: 'Naya account',       icon: 'user-plus' },
      { href: '/forgot-password', label: 'Password bhool gaye', icon: 'lock' },
    ],
  },
  {
    title: 'Maloomat',
    match: (p) => ['/about', '/faq', '/safety', '/contact', '/privacy', '/terms'].includes(p),
    links: [
      { href: '/about',   label: 'Hamare baare mein', icon: 'info' },
      { href: '/faq',     label: 'FAQ',               icon: 'help' },
      { href: '/safety',  label: 'Safety',            icon: 'shield-check' },
      { href: '/contact', label: 'Rabta karein',      icon: 'mail' },
      { href: '/privacy', label: 'Privacy',           icon: 'lock' },
      { href: '/terms',   label: 'Terms',             icon: 'file-text' },
    ],
  },
  {
    title: 'Tutor dhoondna',
    // Search, listing, profile aur saare SEO pages — sab isi kaam ke hain.
    match: (p) =>
      p === '/find-tutor' || p === '/teachers' ||
      p.startsWith('/teachers/') || p.startsWith('/teacher/') ||
      p.startsWith('/city/') || p.startsWith('/subject/') ||
      /-tutor-|^\/tuition-at-tutor-home-/.test(p),
    links: [
      { href: '/find-tutor',    label: 'Filters ke saath search', icon: 'filter' },
      { href: '/teachers',      label: 'Saare tutors',            icon: 'users' },
      { href: '/request-tutor', label: 'Request post karein',     icon: 'send' },
    ],
  },
];

// Base path hata kar saaf raasta — sections isi par match karte hain.
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
let path = Astro.url.pathname;
if (base && path.startsWith(base)) path = path.slice(base.length);
path = path.replace(/\.html$/, '').replace(/\/+$/, '') || '/';

const section = sections.find((s) => s.match(path));

// Jo link section mein aa chuka, usay dobara neeche na dikhayein.
const inSection = new Set(section?.links.map((l) => l.href) ?? []);
const rest = universal.filter((l) => !inSection.has(l.href));
---
<header>
  <div class="wrap nav">
    <Logo href={url('/')} size={38} />

    <nav class="nav-links" aria-label="Main">
      {universal.map((l) => (
        <a href={url(l.href)} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-cta">
      {/* Login ke baad ye do button hat jate hain — JS hint dekh kar. */}
      <div class="auth-out" data-for="out">
        <a class="btn btn-ghost btn-sm" href={url('/login')}>Login</a>
        <a class="btn btn-primary btn-sm" href={url('/signup')}>
          <Icon name="user-plus" />
          Sign up
        </a>
      </div>

      <a class="btn btn-primary btn-sm" href={url('/login')} data-for="in" data-home-link hidden>
        <Icon name="trending-up" />
        Dashboard
      </a>

      <button
        type="button"
        class="menu-btn"
        id="menu-btn"
        aria-controls="site-menu"
        aria-expanded="false"
        aria-label="Menu kholein"
      >
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="menu" id="site-menu" hidden>
    <div class="wrap menu-inner">

      {/* 1. Is section ka — page ke hisaab se */}
      {section && (
        <div class="menu-group">
          <p class="menu-title">{section.title}</p>
          {section.links.map((l) => (
            <a
              class="menu-link"
              href={url(l.href)}
              aria-current={l.href === path ? 'page' : undefined}
            >
              <Icon name={l.icon} size={18} />{l.label}
            </a>
          ))}
        </div>
      )}

      {/* 2. Role ka — browser mein tay hota hai */}
      <div class="menu-group" data-for="tutor" hidden>
        <p class="menu-title">Mera tutor account</p>
        <a class="menu-link" href={url('/tutor/dashboard')}><Icon name="trending-up" size={18} />Dashboard</a>
        <a class="menu-link" href={url('/tutor/leads')}><Icon name="inbox" size={18} />Leads</a>
        <a class="menu-link" href={url('/tutor/profile')}><Icon name="user" size={18} />Meri profile</a>
      </div>

      <div class="menu-group" data-for="learner" hidden>
        <p class="menu-title">Mera account</p>
        <a class="menu-link" href={url('/parent/dashboard')}><Icon name="trending-up" size={18} />Dashboard</a>
        <a class="menu-link" href={url('/parent/requests')}><Icon name="file-text" size={18} />Meri requests</a>
        <a class="menu-link" href={url('/parent/saved-tutors')}><Icon name="bookmark" size={18} />Saved tutors</a>
      </div>

      <div class="menu-group" data-for="admin" hidden>
        <p class="menu-title">Admin</p>
        <a class="menu-link" href={url('/admin')}><Icon name="settings" size={18} />Admin panel</a>
      </div>

      {/* 3. Har jagah wale */}
      {rest.length > 0 && (
        <div class="menu-group">
          <p class="menu-title">ApnaTutor</p>
          {rest.map((l) => (
            <a class="menu-link" href={url(l.href)}><Icon name={l.icon} size={18} />{l.label}</a>
          ))}
        </div>
      )}

      <div class="menu-group" data-for="out">
        <a class="menu-link" href={url('/login')}><Icon name="user" size={18} />Login</a>
        <a class="menu-link" href={url('/signup')}><Icon name="user-plus" size={18} />Naya account banayein</a>
        <a class="menu-link" href={url('/for-tutors')}><Icon name="graduation-cap" size={18} />Tutors ke liye</a>
      </div>

      {/* App install — sirf tab dikhta hai jab phone waqai install kara sakta
          ho. Chrome ise `beforeinstallprompt` se batata hai; iPhone par aisa
          koi ishara nahi milta, is liye wahan tareeqa likh dete hain. */}
      <div class="menu-group" data-install hidden>
        <p class="menu-title">App</p>
        <button type="button" class="menu-link" data-install-run hidden>
          <Icon name="download" size={18} />App install karein
        </button>
        <p class="menu-note" data-install-ios hidden>
          Safari mein neeche <strong>Share</strong> (⬆) dabayein →
          <strong>Add to Home Screen</strong>. Phir ApnaTutor aapke phone par
          app ki tarah khulega.
        </p>
      </div>

      <div class="menu-group" data-for="in" hidden>
        <button type="button" class="menu-link danger" data-menu-signout>
          <Icon name="log-out" size={18} />Logout
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  header{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.94);
    backdrop-filter:blur(8px);border-bottom:1px solid var(--border)}
  .nav{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:var(--space-2)}
  /* Logo bhi ungli ke laayaq — 38px thora chhota tha. */
  .nav :global(.logo){display:inline-flex;align-items:center;min-height:44px}

  .nav-links{display:none;gap:4px}
  .nav-links a{padding:10px 12px;border-radius:var(--radius);color:var(--muted-fg);
    font-weight:500;white-space:nowrap;font-size:15px}
  .nav-links a:hover{background:var(--bg-alt);color:var(--fg);text-decoration:none}
  .nav-links a[aria-current="page"]{color:var(--primary-dark);background:var(--primary-soft)}

  .nav-cta{display:flex;gap:var(--space-1);align-items:center}
  .auth-out{display:flex;gap:var(--space-1);align-items:center}

  /* Chhoti screen par Sign up ka icon jagah kha jata hai — text kaafi hai. */
  @media(max-width:460px){
    .nav-cta :global(.btn .icon){display:none}
    .nav-cta :global(.btn){padding-inline:12px}
  }
  @media(min-width:1040px){ .nav-links{display:flex} }

  /* ---------- Teen lakeerein ---------- */
  .menu-btn{
    width:48px;height:48px;flex:none;
    display:grid;place-items:center;
    background:transparent;border:1px solid var(--border);
    border-radius:var(--radius);cursor:pointer;
    transition:background-color .2s var(--ease),border-color .2s var(--ease);
  }
  .menu-btn:hover{background:var(--bg-alt);border-color:var(--border-strong)}
  .menu-btn[aria-expanded="true"]{background:var(--primary-soft);border-color:var(--primary-border)}

  .bars{display:grid;gap:4px;width:20px}
  .bars span{display:block;height:2px;border-radius:2px;background:var(--fg);
    transition:transform .2s var(--ease),opacity .2s var(--ease)}
  .menu-btn[aria-expanded="true"] .bars span:nth-child(1){transform:translateY(6px) rotate(45deg)}
  .menu-btn[aria-expanded="true"] .bars span:nth-child(2){opacity:0}
  .menu-btn[aria-expanded="true"] .bars span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

  /* ---------- Panel ---------- */
  .menu{
    border-top:1px solid var(--border);
    background:var(--card);
    box-shadow:var(--shadow-lg);
    max-height:min(72vh,620px);
    overflow-y:auto;
  }
  .menu-inner{padding-block:var(--space-2);display:grid;gap:var(--space-2)}

  .menu-group{display:grid;gap:2px}
  .menu-group + .menu-group{border-top:1px solid var(--border);padding-top:var(--space-2)}

  .menu-title{
    font-family:var(--font-heading);font-size:12px;font-weight:600;
    letter-spacing:.09em;text-transform:uppercase;color:var(--muted-fg);
    padding:0 12px 6px;
  }

  .menu-link{
    display:flex;align-items:center;gap:12px;
    min-height:48px;padding:10px 12px;
    border:0;border-radius:var(--radius);
    background:transparent;color:var(--fg);
    font-family:var(--font-heading);font-size:16px;font-weight:500;
    text-align:left;width:100%;cursor:pointer;
  }
  .menu-link:hover{background:var(--bg-alt);text-decoration:none}
  .menu-link :global(.icon){color:var(--icon-muted);flex:none}
  .menu-link[aria-current="page"]{background:var(--primary-soft);color:var(--primary-dark)}
  .menu-link[aria-current="page"] :global(.icon){color:var(--primary)}
  .menu-link.danger{color:var(--destructive)}
  .menu-link.danger :global(.icon){color:var(--destructive)}
  .menu-link.danger:hover{background:#FEF2F2}

  .menu-note{padding:0 12px 8px;font-size:14.5px;color:var(--muted-fg);line-height:1.55}
  .menu-note strong{color:var(--fg)}

  @media (prefers-reduced-motion: reduce){
    .bars span{transition:none}
  }
</style>

<script>
  import { url } from '../lib/site';
  import { isLearner, readAuthHint } from '../lib/auth-hint';
  import { homeForRole } from '../lib/auth-hint';

  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('site-menu');

  if (btn && menu) {
    // ---- Kaun sa hissa kisay dikhe ----
    // Default markup logged-out hai, is liye pehli dafa aane wale ko kuch
    // flash nahi hota. Hint hone par hi swap hota hai.
    const hint = readAuthHint();

    const visible: Record<string, boolean> = {
      out: !hint.signedIn,
      in: hint.signedIn,
      tutor: hint.signedIn && hint.role === 'tutor',
      learner: hint.signedIn && isLearner(hint.role),
      admin: Boolean(hint.admin),
    };

    document.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => {
      const key = el.dataset.for ?? '';
      if (key in visible) el.hidden = !visible[key];
    });

    if (hint.signedIn) {
      const home = url(homeForRole(hint.role));
      document.querySelectorAll<HTMLAnchorElement>('[data-home-link]').forEach((a) => {
        a.href = home;
      });
    }

    // ---- Kholna / band karna ----
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      menu.hidden = !open;
    };

    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    // Link par click — panel khula na reh jaye.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
    });

    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!menu.hidden && !menu.contains(t) && !btn.contains(t)) setOpen(false);
    });

    // ---- App install ----
    // Chrome install se pehle ye event deta hai. Usay rok kar apne paas rakh
    // lete hain, taake apna button dabane par asli prompt khol sakein —
    // browser ka apna banner aksar nazar-andaz ho jata hai.
    const installBox = document.querySelector<HTMLElement>('[data-install]');
    const installBtn = document.querySelector<HTMLButtonElement>('[data-install-run]');
    const iosNote = document.querySelector<HTMLElement>('[data-install-ios]');

    // Pehle se install ho chuki ho to kuch dikhane ka matlab nahi.
    const installed =
      window.matchMedia('(display-mode: standalone)').matches ||
      (navigator as { standalone?: boolean }).standalone === true;

    if (installBox && !installed) {
      let deferred: (Event & { prompt(): Promise<void>; userChoice: Promise<{ outcome: string }> }) | null = null;

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferred = e as typeof deferred;
        installBox.hidden = false;
        if (installBtn) installBtn.hidden = false;
      });

      installBtn?.addEventListener('click', async () => {
        if (!deferred) return;
        installBtn.disabled = true;
        await deferred.prompt();
        await deferred.userChoice;
        // Prompt ek hi baar chalta hai — dobara chahiye to browser naya event dega.
        deferred = null;
        installBox.hidden = true;
      });

      // iPhone/iPad: koi event nahi milta, sirf hidayat di ja sakti hai.
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      if (isIOS && iosNote) {
        installBox.hidden = false;
        iosNote.hidden = false;
      }

      window.addEventListener('appinstalled', () => { installBox.hidden = true; });
    }

    // ---- Logout ----
    // Firebase sirf ab load hoti hai, page load par nahi.
    menu.querySelector('[data-menu-signout]')?.addEventListener('click', async (e) => {
      const el = e.currentTarget as HTMLButtonElement;
      el.disabled = true;
      const { signOut } = await import('../lib/auth');
      await signOut();
      window.location.href = url('/');
    });
  }
</script>
