---
import { url } from '../lib/site';
// src/components/Header.astro — index.html ka header, waisa ka waisa
import Icon from './Icon.astro';
import Logo from './Logo.astro';
---
<header>
  <div class="wrap nav">
    <Logo href={url('/')} size={38} />

    <nav class="nav-links" aria-label="Main">
      <a href={url('/find-tutor')}>Tutor dhoondein</a>
      <a href={url('/request-tutor')}>Request post karein</a>
      <a href={url('/how-it-works')}>Kaise kaam karta hai</a>
      <a href={url('/teachers')}>Saare tutors</a>
    </nav>

    {/* ★ Header ka primary CTA "Tutor banein" tha. Ab Sign up hai.
        Wajah: jitne zyada parents aur students account banayenge, utne hi
        zyada tutors khud aayenge — ulta nahi. Tutors ka raasta phir bhi
        mojood hai: footer ka "Tutors ke liye" aur homepage ka recruit
        section. Login mobile par bhi dikhta hai — wapas aane wala banda
        pehli cheez wahi dhoondta hai. */}
    <div class="nav-cta">
      <a class="btn btn-ghost btn-sm" href={url('/login')}>Login</a>
      <a class="btn btn-primary btn-sm" href={url('/signup')}>
        <Icon name="user-plus" />
        Sign up
      </a>
    </div>
  </div>
</header>

<style>
  header{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.94);
    backdrop-filter:blur(8px);border-bottom:1px solid var(--border)}
  .nav{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:var(--space-2)}
  .nav-links{display:none;gap:4px}
  .nav-links a{padding:10px 12px;border-radius:var(--radius);color:var(--muted-fg);
    font-weight:500;white-space:nowrap;font-size:15px}
  .nav-links a:hover{background:var(--bg-alt);color:var(--fg);text-decoration:none}
  .nav-cta{display:flex;gap:var(--space-1);align-items:center}
  /* Chhoti screen par Sign up ka icon jagah kha jata hai — text kaafi hai. */
  @media(max-width:420px){
    .nav-cta :global(.btn-primary .icon){display:none}
    .nav-cta :global(.btn){padding-inline:12px}
  }
  @media(min-width:1040px){ .nav-links{display:flex} }
</style>
