---
// src/components/Header.astro — index.html ka header, waisa ka waisa
import Icon from './Icon.astro';
import Logo from './Logo.astro';
---
<header>
  <div class="wrap nav">
    <Logo href="/" size={38} />

    <nav class="nav-links" aria-label="Main">
      <a href="/find-tutor">Tutor dhoondein</a>
      <a href="/request-tutor">Request post karein</a>
      <a href="/how-it-works">Kaise kaam karta hai</a>
      <a href="/teachers">Saare tutors</a>
    </nav>

    <div class="nav-cta">
      <a class="btn btn-ghost btn-sm" href="/login">Login</a>
      <a class="btn btn-primary btn-sm" href="/tutor/register">
        <Icon name="user-plus" />
        Tutor banein
      </a>
    </div>
  </div>
</header>

<style>
  header{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.94);
    backdrop-filter:blur(8px);border-bottom:1px solid var(--border)}
  .nav{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:var(--space-2)}
  .nav-links{display:none;gap:4px}
  .nav-links a{padding:10px 12px;border-radius:var(--radius);color:var(--muted-fg);
    font-weight:500;white-space:nowrap;font-size:15px}
  .nav-links a:hover{background:var(--bg-alt);color:var(--fg);text-decoration:none}
  .nav-cta{display:flex;gap:var(--space-1);align-items:center}
  .nav-cta :global(.btn-ghost){display:none}
  @media(min-width:1040px){
    .nav-links{display:flex}
    .nav-cta :global(.btn-ghost){display:inline-flex}
  }
</style>
