{
  "name": "apnatutor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ApnaTutor \u2014 Pakistan ka tutor marketplace. Astro SSG + Firebase Spark + GitHub Pages.",
  "scripts": {
    "fetch-data": "node scripts/fetch-data.mjs",
    "dev": "npm run fetch-data && astro dev",
    "build": "astro build",
    "validate-seo": "node scripts/validate-seo.mjs",
    "build:full": "npm run fetch-data && npm run build && npm run validate-seo",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run test:rules",
    "test:rules": "firebase emulators:exec --project=apnatutor-rules-test --only firestore \"vitest run\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.1",
    "firebase": "^12.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^15.30.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
