# =============================================================================
# ApnaTutor — environment variables
#
# Is file ko .env mein copy karo aur asli values daalo. .env kabhi commit na ho.
# Sab PUBLIC_ prefix wali values browser bundle mein jati hain — ye by design
# hai (Firebase web config public hoti hai, asli protection firestore.rules hai).
# =============================================================================

# ---- Firebase (Console → Project Settings → General → Your apps → Web app) ----
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=apnatutor-prod.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=apnatutor-prod
PUBLIC_FIREBASE_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# ---- App Check (Console → App Check → reCAPTCHA v3) ----
PUBLIC_RECAPTCHA_SITE_KEY=

# Sirf local development ke liye. Production build mein KABHI set na karo.
# PUBLIC_APPCHECK_DEBUG_TOKEN=

# ---- Analytics / Ads (docs/03-SEO-ANALYTICS.md) ----
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# Note: Firebase ki ye values src/lib/firebase.ts mein pehle se committed hain
# (web config public hoti hai — asli protection rules aur App Check hain).
# Yahan sirf tab set karein jab koi ALAG project (dev/staging) chalana ho.

# ---- Sirf build time (GitHub Actions secret) — browser mein kabhi nahi ----
# Poori service account JSON ek line mein.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# ---- Rabta (contact page par dikhta hai) ----
PUBLIC_CONTACT_EMAIL=
# ApnaTutor ka apna WhatsApp number, +92XXXXXXXXXX format mein.
# Ye SEO gate ke phone-leak check se mustasna hai (build ke waqt bhi set karo).
PUBLIC_OFFICIAL_WHATSAPP=

# ---- Admin rebuild button (/admin/rebuild) ----
# "owner/repo" — misal: umair34836-sys/Apna-tutor
PUBLIC_GITHUB_REPO=
PUBLIC_GITHUB_WORKFLOW=deploy.yml
# NOTE: GitHub token yahan NAHI aata. Wo admin apne browser mein daalta hai aur
# sirf usi browser mein rehta hai — code ya bundle mein kabhi nahi.
